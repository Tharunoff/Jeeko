{
  "expo": {
    "name": "PersonalOS",
    "slug": "personalos",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PersonalOS uses the microphone so you can talk to your assistant instead of typing."
      }
    },
    "android": {
      "package": "com.personalos.app",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": ["RECORD_AUDIO", "POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-audio", "expo-sqlite", "expo-notifications"]
  }
}
